# Opcional -- sube el rate limit de GitHub de 60 a 5000 req/hora.
# Generar en https://github.com/settings/tokens (sin scopes especiales).
GITHUB_TOKEN=

# Requeridas para notificaciones push. Se generan una sola vez, no dependen
# de ninguna cuenta externa -- ver README, sección "Notificaciones push".
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu@email.com

# Requerida para notificaciones push -- viene sola al conectar tu proyecto
# de Neon desde el dashboard de Vercel (Storage → Connect Store → Neon).
DATABASE_URL=

# Requerida para notificaciones push -- string random de al menos 16
# caracteres, la genera Vercel automático si la dejás vacía y usás
# "Generate" en el dashboard, o generala vos con: openssl rand -hex 16
CRON_SECRET=
